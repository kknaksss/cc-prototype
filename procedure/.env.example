# procedure — 이름만(public 레포 · 값 넣지 않는다). 복사해 `procedure/.env` 하나로 채운다(gitignore). 채우는 법은 README.
# compose 가 back 에는 env_file 로, front 에는 NEXT_PUBLIC_* 를 build.args 로 넘긴다.
# --- back · KOS(데모 지점만 · 운영 명동점 키 금지) ---
KOS_OPEN_API_BASE=
KOS_OPEN_API_KEY=
KOS_INTERNAL_API_BASE=
KOS_TENANT_ID=
KOS_SYSTEM_EMAIL=
KOS_SYSTEM_PASSWORD=
KOS_ZONE_ID=
KOS_EXCLUDE_ACCOUNT_IDS=
KOS_POLL_SCHEDULE_SEC=
KOS_POLL_MASTER_SEC=
KOS_POLL_WINDOW=
# --- back · ccc ---
# 로그인 = 아이디 + 비밀번호(OQ-601). 비밀번호는 서버 시작 때 bcrypt 해시로 DB 에 — 아이디 · 비밀번호가 비면 그 계정은 못 들어온다
CCC_ADMIN_ID=
CCC_ADMIN_PASSWORD=
# PoC 의사 — 아이디 · 비밀번호 + 연결할 KOS 데모 지점 실제 원장 계정 id(getAccounts id · 시스템 계정 X)
CCC_DOCTOR_ID=
CCC_DOCTOR_PASSWORD=
CCC_DOCTOR_KOS_ACCOUNT_ID=
# PoC 간호사 — 아이디 · 비밀번호 · 표시 이름
CCC_NURSE_ID=
CCC_NURSE_PASSWORD=
CCC_NURSE_NAME=
# --- back · 원장 호출 푸시(APNs 직접 · SPEC-004 §5-1) — 하나라도 비면 발송을 끈다(조작은 그대로) ---
# .p8 키 파일 경로(레포 밖) · Key ID · 팀 id · 앱 번들 id · sandbox | production(TestFlight = production)
APNS_KEY_PATH=
# compose 전용 — 호스트의 .p8 경로(레포 밖). compose 가 /run/secrets/apns.p8 로 읽기 전용 마운트 → APNS_KEY_PATH=/run/secrets/apns.p8
APNS_KEY_HOST_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENV=
# --- back · 통역(Soniox STT · TTS) ---
SONIOX_API_KEY=
# (선택) 브라우저에서 통역 WS 를 열 때 허용 출처 — 비면 PROC_FRONT_ORIGIN
PROC_INTERPRET_ORIGIN=
PROC_SESSION_SECRET=
PROC_DB_PATH=
PROC_BACK_PORT=
PROC_FRONT_ORIGIN=
# 개발 전용 · 배포 env 에 넣지 않는다 — 1 이면 /api/board · /stream 이 가짜 스냅샷, 조작 API 는 403
PROC_FAKE_BOARD=
# --- front(빌드 인자 · 브라우저가 부르는 back 주소, 비면 compose 가 http://localhost:8700) ---
NEXT_PUBLIC_API_BASE_URL=
